# ============================================================================
#  backend/.env.example — copia este archivo como .env y llena los valores.
#  .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================================

# Entorno: development | production (test lo pone Jest solo)
NODE_ENV=development
PORT=3000

# URL pública de esta API (para armar los enlaces de las fotos subidas).
# En Render: https://<tu-servicio>.onrender.com
URL_PUBLICA=

# Orígenes del frontend permitidos por CORS, separados por coma.
FRONTEND_URL=http://localhost:5173

# PostgreSQL. Vacío = modo demo en memoria (los datos se pierden al reiniciar).
# Supabase → Project Settings → Database → Connection string.
#   DATABASE_URL: la del pooler (puerto 6543) con ?pgbouncer=true
#   DIRECT_URL:   la conexión directa (puerto 5432), la usa `prisma migrate`
DATABASE_URL=
DIRECT_URL=

# Clave para firmar los JWT (una cadena larga y aleatoria). Obligatoria en producción.
JWT_SECRETO=
JWT_EXPIRA=7d

# Reglas de negocio configurables
MINUTOS_SEPARACION=15
HORAS_CANCELACION=6
PORCENTAJE_ADELANTO=30
HORAS_MAXIMAS_RESERVA=3
DIAS_ANTICIPACION=30

# Contraseña de los usuarios de prueba que crea la semilla (opcional).
SEMILLA_PASSWORD=

# Supabase Storage para las fotos en producción (vacío = disco local en uploads/).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=canchitas
