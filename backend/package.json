{
  "name": "canchitas-cusco-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Canchitas Cusco: reservas de canchitas de fulbito del círculo local, con pagos Yape/Plin manuales y panel de dueños y administración",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generar": "prisma generate",
    "migrar": "prisma migrate dev",
    "migrar:produccion": "prisma migrate deploy",
    "semilla": "node prisma/semilla.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "cobertura": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "postinstall": "prisma generate",
    "crear-admin": "node scripts/crear-admin.js"
  },
  "prisma": {
    "seed": "node prisma/semilla.js"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Aguirre Bravo, Edson Francisco Lino; Canal Sayago, Pabel Junior; Carpio Letona, Rafit Holger; Paredes Claros, Adrian Mauricio",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/020200141d-coder/TukanchitaP.git"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "prisma"
    ],
    "ext": "js,json"
  }
}
